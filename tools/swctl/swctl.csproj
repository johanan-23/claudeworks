<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer helper: load/unload the add-in in a running SOLIDWORKS (typed interop). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <SwInstallDir Condition="'$(SwInstallDir)' == ''">D:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SwInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwInstallDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
</Project>
